#!/usr/bin/env python3
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parents[1]
python = root / '.venv' / 'bin' / 'python'
if not python.is_file() or not (root / '.venv' / 'pyvenv.cfg').is_file():
    sys.exit(f'SageQueue environment is missing. Run {root}/bin/setup.sh.')
os.execv(str(python), [str(python), str(root / 'sagequeue.py'), *sys.argv[1:]])
